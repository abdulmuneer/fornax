+"""Apple (Metal) correctness-first MLA decode fallback.
+
+This is the MLA counterpart to `naive_fa_decode_apple`: one simdgroup owns one
+`(batch, head, split)` producer block, computes Q.K over the full MLA cache row,
+and accumulates P.V over the latent/value prefix of the same row. A stitch kernel
+combines split-K partials.
+
+It is intentionally narrow for M3 bring-up: ragged KV-cache decode, BF16/FP16
+storage, one query token per sequence, no sparse/FP8/attention-sink paths.
+"""
+
+from std.collections import OptionalReg
+from std.gpu import WARP_SIZE, block_idx, lane_id, thread_idx
+from std.gpu.host import DeviceContext
+from std.gpu.memory import AddressSpace
+from std.math import ceildiv, exp
+from std.sys import llvm_intrinsic
+from std.utils.index import Index
+from std.utils.numerics import get_accum_type
+
+from layout import TileTensor
+from layout.coord import Coord
+from layout.tile_layout import TensorLayout, row_major
+
+from nn.attention.mha_mask import MHAMask
+from nn.attention.mha_operand import MHAOperand
+from nn.attention.gpu.mha import mha_gpu_naive
+
+
+comptime MLA_DECODE_APPLE_SPLIT_SIZE = 32
+comptime MLA_DECODE_APPLE_MAX_DEPTH = 576
+comptime MLA_DECODE_APPLE_COPY_BLOCK = 128
+comptime NEG_INF = Float32(-3.0e38)
+
+
+@always_inline
+def _apple_simd_sum(val: Float32) -> Float32:
+    return llvm_intrinsic["llvm.air.simd_sum", Float32](val)
+
+
+@always_inline
+def _ml_idx(
+    b: Int, head: Int, split: Int, num_heads: Int, num_partitions: Int
+) -> Int:
+    return (b * num_heads + head) * num_partitions + split
+
+
+@always_inline
+def _o_idx(
+    b: Int,
+    head: Int,
+    d: Int,
+    split: Int,
+    num_heads: Int,
+    depth_v: Int,
+    num_partitions: Int,
+) -> Int:
+    return ((b * num_heads + head) * depth_v + d) * num_partitions + split
+
+
+def mla_decode_apple_core[
+    q_type: DType,
+    output_type: DType,
+    p_type: DType,
+    k_t: MHAOperand,
+    mask_t: MHAMask,
+    p_layout: TensorLayout,
+    q_layout: TensorLayout,
+    valid_length_layout: TensorLayout,
+    ragged: Bool = True,
+    _use_valid_length: Bool = True,
+    _is_cache_length_accurate: Bool = False,
+    *,
+    Depth: Int,
+    DepthV: Int,
+    SplitSize: Int,
+](
+    o_partial: TileTensor[p_type, p_layout, MutAnyOrigin],
+    m_partial: TileTensor[p_type, p_layout, MutAnyOrigin],
+    l_partial: TileTensor[p_type, p_layout, MutAnyOrigin],
+    q: TileTensor[q_type, q_layout, ImmutAnyOrigin],
+    k: k_t,
+    mask_functor: mask_t,
+    valid_length: TileTensor[
+        DType.uint32,
+        valid_length_layout,
+        ImmutAnyOrigin,
+    ],
+    scale: Float32,
+    batch_size: Int,
+    max_prompt_len: Int,
+    max_cache_size: Int,
+    num_heads: Int,
+    depth: Int,
+    depth_v: Int,
+    group: Int,
+    num_partitions: Int,
+):
+    comptime assert Depth % WARP_SIZE == 0, (
+        "mla_decode_apple_core requires Depth % WARP_SIZE == 0"
+    )
+    comptime assert DepthV % WARP_SIZE == 0, (
+        "mla_decode_apple_core requires DepthV % WARP_SIZE == 0"
+    )
+    comptime assert DepthV <= Depth, "MLA value depth must be a prefix of K"
+    comptime assert ragged, "Apple MLA decode fallback currently supports ragged only"
+    comptime assert (
+        not _is_cache_length_accurate
+    ), "Apple MLA decode fallback expects KV cache length before the new token"
+    comptime Q_EPL = Depth // WARP_SIZE
+    comptime O_EPL = DepthV // WARP_SIZE
+    debug_assert(depth == Depth, "runtime depth must match comptime Depth")
+    debug_assert(depth_v == DepthV, "runtime depth_v must match comptime DepthV")
+
+    var split_id = Int(block_idx.x)
+    var batch_id = Int(block_idx.y)
+    var head_id = Int(block_idx.z)
+    var kv_head = head_id // group
+    var lane = Int(lane_id())
+
+    var seq_start: Int
+    var cur_query_len: Int
+    var q_offset: Int
+    var cur_cache_len: Int
+    comptime if ragged:
+        seq_start = Int(valid_length[batch_id])
+        var seq_end = Int(valid_length[batch_id + 1])
+        cur_query_len = seq_end - seq_start
+        q_offset = Depth * (seq_start * num_heads + head_id)
+        cur_cache_len = k.cache_length(batch_id) + cur_query_len
+    elif _use_valid_length:
+        seq_start = batch_id
+        cur_query_len = Int(valid_length[batch_id])
+        q_offset = Depth * (head_id + num_heads * max_prompt_len * batch_id)
+        cur_cache_len = k.cache_length(batch_id) + cur_query_len
+    else:
+        seq_start = batch_id
+        cur_query_len = max_prompt_len
+        q_offset = Depth * (head_id + num_heads * max_prompt_len * batch_id)
+        cur_cache_len = max_cache_size
+
+    # This fallback is decode-only. The graph router should send S>1 to prefill.
+    if cur_query_len != 1:
+        return
+
+    var start = split_id * SplitSize
+    if start >= cur_cache_len:
+        return
+    var end = min(start + SplitSize, cur_cache_len)
+    var score_row = cur_cache_len - cur_query_len
+
+    var q_frag = q.load[width=Q_EPL](Coord(q_offset + lane * Q_EPL)).cast[
+        DType.float32
+    ]()
+    var k_layout = row_major(Coord(Depth))
+    var v_layout = row_major(Coord(DepthV))
+
+    var m = NEG_INF
+    var l = Float32(0.0)
+    var o_frag = SIMD[DType.float32, O_EPL](0.0)
+
+    for kv0 in range(start, end, SplitSize):
+        var partials = SIMD[DType.float32, SplitSize](0.0)
+
+        comptime for kk in range(SplitSize):
+            var j = kv0 + kk
+            if j < end:
+                var k_tile = k.block_paged_tile[1](
+                    UInt32(batch_id),
+                    UInt32(j),
+                    UInt32(kv_head),
+                    k_layout,
+                )
+                var kvec = k_tile.load[width=Q_EPL](Coord(lane * Q_EPL)).cast[
+                    DType.float32
+                ]()
+                partials[kk] = (q_frag * kvec).reduce_add()
+
+        var scores = SIMD[DType.float32, SplitSize](NEG_INF)
+        comptime for kk in range(SplitSize):
+            var j = kv0 + kk
+            if j < end:
+                var s = _apple_simd_sum(partials[kk]) * scale
+                scores[kk] = mask_functor.mask(
+                    Index(batch_id, head_id, score_row, j), s
+                )
+
+        var m_tile = scores.reduce_max()
+        var m_new = max(m, m_tile)
+        var alpha = exp(m - m_new)
+        var p = exp(scores - m_new)
+        l = l * alpha + p.reduce_add()
+        m = m_new
+        o_frag = o_frag * alpha
+
+        comptime for kk in range(SplitSize):
+            var j = kv0 + kk
+            if j < end:
+                var v_tile = k.block_paged_tile[1](
+                    UInt32(batch_id),
+                    UInt32(j),
+                    UInt32(kv_head),
+                    v_layout,
+                )
+                var vvec = v_tile.load[width=O_EPL](Coord(lane * O_EPL)).cast[
+                    DType.float32
+                ]()
+                o_frag = o_frag + p[kk] * vvec
+
+    comptime assert (
+        o_partial.flat_rank == 1
+        and m_partial.flat_rank == 1
+        and l_partial.flat_rank == 1
+    ), "partials are flat 1D TileTensors"
+    comptime for i in range(O_EPL):
+        var d = lane * O_EPL + i
+        var oi = _o_idx(
+            batch_id, head_id, d, split_id, num_heads, DepthV, num_partitions
+        )
+        o_partial[oi] = rebind[o_partial.ElementType](
+            SIMD[p_type, 1](o_frag[i].cast[p_type]())
+        )
+    if lane == 0:
+        var idx = _ml_idx(
+            batch_id, head_id, split_id, num_heads, num_partitions
+        )
+        l_partial[idx] = rebind[l_partial.ElementType](
+            SIMD[p_type, 1](l.cast[p_type]())
+        )
+        m_partial[idx] = rebind[m_partial.ElementType](
+            SIMD[p_type, 1](m.cast[p_type]())
+        )
+
+
+def mla_decode_apple_stitch[
+    output_type: DType,
+    p_type: DType,
+    k_t: MHAOperand,
+    mask_t: MHAMask,
+    output_layout: TensorLayout,
+    p_layout: TensorLayout,
+    valid_length_layout: TensorLayout,
+    ragged: Bool = True,
+    _use_valid_length: Bool = True,
+    _is_cache_length_accurate: Bool = False,
+    *,
+    SplitSize: Int,
+](
+    output: TileTensor[output_type, output_layout, MutAnyOrigin],
+    o_partial: TileTensor[p_type, p_layout, ImmutAnyOrigin],
+    m_partial: TileTensor[p_type, p_layout, ImmutAnyOrigin],
+    l_partial: TileTensor[p_type, p_layout, ImmutAnyOrigin],
+    k: k_t,
+    valid_length: TileTensor[
+        DType.uint32,
+        valid_length_layout,
+        ImmutAnyOrigin,
+    ],
+    max_prompt_len: Int,
+    max_cache_size: Int,
+    num_heads: Int,
+    depth_v: Int,
+    num_partitions: Int,
+):
+    comptime assert ragged, "Apple MLA decode fallback currently supports ragged only"
+    comptime assert (
+        not _is_cache_length_accurate
+    ), "Apple MLA decode fallback expects KV cache length before the new token"
+    var head_id = Int(block_idx.x)
+    var batch_id = Int(block_idx.y)
+    var d = Int(thread_idx.x)
+
+    if d >= depth_v:
+        return
+
+    var seq_start: Int
+    var cur_query_len: Int
+    var cur_cache_len: Int
+    comptime if ragged:
+        seq_start = Int(valid_length[batch_id])
+        var seq_end = Int(valid_length[batch_id + 1])
+        cur_query_len = seq_end - seq_start
+        cur_cache_len = k.cache_length(batch_id) + cur_query_len
+    elif _use_valid_length:
+        seq_start = batch_id
+        cur_query_len = Int(valid_length[batch_id])
+        cur_cache_len = k.cache_length(batch_id) + cur_query_len
+    else:
+        seq_start = batch_id
+        cur_query_len = max_prompt_len
+        cur_cache_len = max_cache_size
+
+    if cur_query_len != 1:
+        return
+
+    comptime assert (
+        o_partial.flat_rank == 1
+        and m_partial.flat_rank == 1
+        and l_partial.flat_rank == 1
+        and output.flat_rank == 1
+    ), "partials and output are flat 1D TileTensors"
+
+    var active_splits = ceildiv(cur_cache_len, SplitSize)
+    var m = NEG_INF
+    var l = Float32(0.0)
+    var acc = Float32(0.0)
+
+    for split in range(active_splits):
+        var ml = _ml_idx(batch_id, head_id, split, num_heads, num_partitions)
+        var m_s = rebind[Scalar[p_type]](m_partial[ml]).cast[DType.float32]()
+        var m_new = max(m, m_s)
+        var corr = exp(m - m_new)
+        var p = exp(m_s - m_new)
+        var l_s = rebind[Scalar[p_type]](l_partial[ml]).cast[DType.float32]()
+        l = l * corr + p * l_s
+        var oi = _o_idx(
+            batch_id, head_id, d, split, num_heads, depth_v, num_partitions
+        )
+        var o_s = rebind[Scalar[p_type]](o_partial[oi]).cast[DType.float32]()
+        acc = acc * corr + p * o_s
+        m = m_new
+
+    var out_off = (seq_start * num_heads + head_id) * depth_v
+    output[out_off + d] = rebind[output.ElementType](
+        SIMD[output_type, 1]((acc / l).cast[output_type]())
+    )
+
+
+def mla_decode_apple_copy_latent[
+    output_type: DType,
+    output_layout: TensorLayout,
+    temp_layout: TensorLayout,
+](
+    output: TileTensor[output_type, output_layout, MutAnyOrigin],
+    temp: TileTensor[output_type, temp_layout, ImmutAnyOrigin],
+    total_rows: Int,
+    depth: Int,
+    depth_v: Int,
+):
+    var d = Int(block_idx.x) * MLA_DECODE_APPLE_COPY_BLOCK + Int(thread_idx.x)
+    var row = Int(block_idx.y)
+    if row >= total_rows or d >= depth_v:
+        return
+    comptime assert (
+        output.flat_rank == 1 and temp.flat_rank == 1
+    ), "copy inputs are flat 1D TileTensors"
+    output[row * depth_v + d] = temp[row * depth + d]
+
+
+def mla_decode_apple[
+    q_type: DType,
+    output_type: DType,
+    k_t: MHAOperand,
+    mask_t: MHAMask,
+    *,
+    ragged: Bool = True,
+    _use_valid_length: Bool = True,
+    _is_cache_length_accurate: Bool = False,
+](
+    output: TileTensor[
+        mut=True, output_type, address_space=AddressSpace.GENERIC, ...
+    ],
+    q: TileTensor[q_type, address_space=AddressSpace.GENERIC, ...],
+    k: k_t,
+    mask_functor: mask_t,
+    valid_length: TileTensor[
+        DType.uint32, address_space=AddressSpace.GENERIC, ...
+    ],
+    scale: Float32,
+    batch_size: Int,
+    max_prompt_len: Int,
+    max_cache_size: Int,
+    num_heads: Int,
+    depth: Int,
+    depth_v: Int,
+    group: Int,
+    ctx: DeviceContext,
+) raises:
+    comptime assert q_type in (DType.bfloat16, DType.float16), (
+        "mla_decode_apple initially supports bf16/fp16 inputs only"
+    )
+    comptime assert output_type in (DType.bfloat16, DType.float16), (
+        "mla_decode_apple initially supports bf16/fp16 outputs only"
+    )
+    comptime assert k_t.dtype == q_type, (
+        "mla_decode_apple expects KV cache dtype to match Q dtype"
+    )
+    comptime assert ragged, "mla_decode_apple currently supports ragged decode only"
+    comptime assert (
+        not _is_cache_length_accurate
+    ), "mla_decode_apple expects cache_length before the new token"
+
+    if batch_size == 0 or max_prompt_len == 0:
+        return
+
+    debug_assert(max_prompt_len == 1, "mla_decode_apple is decode-only")
+    debug_assert(depth % WARP_SIZE == 0, "MLA decode depth must split by simdgroup")
+    debug_assert(
+        depth_v % WARP_SIZE == 0,
+        "MLA decode output depth must split by simdgroup",
+    )
+    debug_assert(depth <= MLA_DECODE_APPLE_MAX_DEPTH, "unsupported MLA depth")
+    debug_assert(depth_v <= depth, "MLA value depth must be a prefix of K")
+
+    var total_rows = Int(output.num_elements()) // depth_v
+    var temp_n = total_rows * depth
+    var temp_dev = ctx.enqueue_create_buffer[output_type](temp_n)
+    var temp_tt = TileTensor(temp_dev, row_major(Coord(temp_n)))
+    var latent_output_flat = TileTensor(
+        output.ptr.as_unsafe_any_origin(),
+        row_major(Coord(Int(output.num_elements()))),
+    )
+    var temp_imm = TileTensor(
+        temp_dev.unsafe_ptr().as_immutable().as_unsafe_any_origin(),
+        row_major(Coord(temp_n)),
+    )
+
+    mha_gpu_naive[
+        ragged=ragged,
+        _use_valid_length=_use_valid_length,
+        _is_cache_length_accurate=_is_cache_length_accurate,
+    ](
+        q.to_layout_tensor(),
+        k,
+        k,
+        mask_functor,
+        temp_tt.to_layout_tensor(),
+        valid_length.to_layout_tensor(),
+        scale,
+        batch_size,
+        max_prompt_len,
+        max_cache_size,
+        num_heads,
+        depth,
+        group,
+        ctx,
+    )
+
+    comptime copy_kernel = mla_decode_apple_copy_latent[
+        output_type,
+        type_of(latent_output_flat).LayoutType,
+        type_of(temp_imm).LayoutType,
+    ]
+    ctx.enqueue_function[copy_kernel](
+        latent_output_flat,
+        temp_imm,
+        total_rows,
+        depth,
+        depth_v,
+        grid_dim=(ceildiv(depth_v, MLA_DECODE_APPLE_COPY_BLOCK), total_rows),
+        block_dim=MLA_DECODE_APPLE_COPY_BLOCK,
+    )
+
+    _ = temp_dev^

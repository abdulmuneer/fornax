+
+from builtin_kernels import Gather
+from extensibility import (
+    StaticTensorSpec,
+    _FusedInputTensor as FusedInputTensor,
+    _FusedOutputTensor as FusedOutputTensor,
+)
+from std.gpu.host import DeviceContext
+from std.sys import has_apple_gpu_accelerator
+from std.testing import assert_equal
+from std.utils import IndexList
+
+
+def test_apple_gather_axis0_rank2[
+    indices_type: DType
+](ctx: DeviceContext) raises:
+    print("Apple rank-2 gather indices dtype:", indices_type)
+    comptime INPUT_ROWS = 5
+    comptime COLS = 8
+    comptime NUM_INDICES = 6
+    comptime input_spec = StaticTensorSpec[
+        DType.float32, 2, ...
+    ].get_unknown()
+    comptime indices_spec = StaticTensorSpec[
+        indices_type, 1, ...
+    ].get_unknown()
+    comptime output_spec = StaticTensorSpec[
+        DType.float32, 2, ...
+    ].get_unknown()
+
+    var input_h = ctx.enqueue_create_host_buffer[DType.float32](
+        INPUT_ROWS * COLS
+    )
+    var indices_h = ctx.enqueue_create_host_buffer[indices_type](NUM_INDICES)
+    var output_h = ctx.enqueue_create_host_buffer[DType.float32](
+        NUM_INDICES * COLS
+    )
+    var input_d = ctx.enqueue_create_buffer[DType.float32](INPUT_ROWS * COLS)
+    var indices_d = ctx.enqueue_create_buffer[indices_type](NUM_INDICES)
+    var output_d = ctx.enqueue_create_buffer[DType.float32](
+        NUM_INDICES * COLS
+    )
+
+    for row in range(INPUT_ROWS):
+        for col in range(COLS):
+            input_h[row * COLS + col] = Float32(row * 100 + col)
+
+    comptime if indices_type == DType.int32:
+        indices_h[0] = -1
+    else:
+        indices_h[0] = Scalar[indices_type](INPUT_ROWS - 1)
+    indices_h[1] = 0
+    indices_h[2] = 2
+    indices_h[3] = 4
+    indices_h[4] = 1
+    indices_h[5] = 3
+
+    for i in range(NUM_INDICES * COLS):
+        output_h[i] = -777.0
+
+    ctx.enqueue_copy(input_d, input_h)
+    ctx.enqueue_copy(indices_d, indices_h)
+    ctx.enqueue_copy(output_d, output_h)
+
+    var input = FusedInputTensor[static_spec=input_spec](
+        input_d.unsafe_ptr(), IndexList[2](INPUT_ROWS, COLS)
+    )
+    var indices = FusedInputTensor[static_spec=indices_spec](
+        indices_d.unsafe_ptr(), IndexList[1](NUM_INDICES)
+    )
+    var output = FusedOutputTensor[static_spec=output_spec](
+        output_d.unsafe_ptr(), IndexList[2](NUM_INDICES, COLS)
+    )
+
+    Gather.execute[
+        target="gpu",
+        _trace_name="apple_gather_axis0_rank2_smoke",
+        axis=0,
+        input_rank=2,
+        indices_rank=1,
+    ](output, input, indices, ctx)
+
+    ctx.synchronize()
+
+    ctx.enqueue_copy(output_h, output_d)
+    ctx.synchronize()
+
+    for idx_pos in range(NUM_INDICES):
+        var expected_row = 0
+        if idx_pos == 0:
+            expected_row = INPUT_ROWS - 1
+        elif idx_pos == 2:
+            expected_row = 2
+        elif idx_pos == 3:
+            expected_row = 4
+        elif idx_pos == 4:
+            expected_row = 1
+        elif idx_pos == 5:
+            expected_row = 3
+        for col in range(COLS):
+            assert_equal(
+                output_h[idx_pos * COLS + col],
+                Float32(expected_row * 100 + col),
+                "axis-0 rank-2 gather produced the wrong element",
+            )
+
+
+def main() raises:
+    comptime if not has_apple_gpu_accelerator():
+        print("SKIP: Apple rank-2 gather smoke requires Apple GPU")
+        return
+
+    with DeviceContext() as ctx:
+        test_apple_gather_axis0_rank2[DType.int32](ctx)
+        test_apple_gather_axis0_rank2[DType.uint32](ctx)
+        print("Apple rank-2 gather smoke passed")

+
+    var q_size = batch_size * q_max_seq_len * NUM_HEADS * DEPTH
+    var output_size = batch_size * q_max_seq_len * NUM_HEADS * V_DEPTH
+    var num_pages = ceildiv(num_keys, PAGE_SIZE)
+    var block_elems = (
+        num_pages * NUM_LAYERS * PAGE_SIZE * KV_NUM_HEADS * DEPTH
+    )
+
+    var q_host = alloc[Scalar[qkv_type]](q_size)
+    var blocks_host = alloc[Scalar[qkv_type]](block_elems)
+    var output_host = alloc[Scalar[output_type]](output_size)
+    var row_offsets_host = alloc[UInt32](batch_size + 1)
+    var cache_lengths_host = alloc[UInt32](batch_size)
+    var lookup_table_host = alloc[UInt32](num_pages)
+
+    randn[qkv_type](q_host, q_size)
+    randn[qkv_type](blocks_host, block_elems)
+    row_offsets_host[0] = UInt32(0)
+    row_offsets_host[1] = UInt32(q_max_seq_len)
+    cache_lengths_host[0] = UInt32(cache_len)
+    _fill_lookup_table(lookup_table_host, num_pages)
+
+    var q_device = ctx.enqueue_create_buffer[qkv_type](q_size)
+    var blocks_device = ctx.enqueue_create_buffer[qkv_type](block_elems)
+    var output_device = ctx.enqueue_create_buffer[output_type](output_size)
+    var row_offsets_device = ctx.enqueue_create_buffer[DType.uint32](
+        batch_size + 1
+    )
+    var cache_lengths_device = ctx.enqueue_create_buffer[DType.uint32](
+        batch_size
+    )
+    var lookup_table_device = ctx.enqueue_create_buffer[DType.uint32](num_pages)
+    var scalar_args_device = ctx.enqueue_create_buffer[DType.int64](3)
+
+    ctx.enqueue_copy(q_device, q_host)
+    ctx.enqueue_copy(blocks_device, blocks_host)
+    ctx.enqueue_copy(row_offsets_device, row_offsets_host)
+    ctx.enqueue_copy(cache_lengths_device, cache_lengths_host)
+    ctx.enqueue_copy(lookup_table_device, lookup_table_host)
+
+    var q_tt = TileTensor(
+        q_device,
+        row_major((batch_size * q_max_seq_len, Idx[NUM_HEADS], Idx[DEPTH])),
+    )
+    var output_tt = TileTensor(
+        output_device,
+        row_major((batch_size * q_max_seq_len, Idx[NUM_HEADS], Idx[V_DEPTH])),
+    )
+    var row_offsets_tt = TileTensor(
+        row_offsets_device,
+        row_major(batch_size + 1),
+    )
+    var scalar_args_tt = TileTensor(scalar_args_device, row_major[3]())
+
+    comptime kv_params = KVCacheStaticParams(
+        num_heads=KV_NUM_HEADS, head_size=DEPTH, is_mla=True
+    )
+    var block_shape = IndexList[6](
+        num_pages,
+        1,
+        NUM_LAYERS,
+        PAGE_SIZE,
+        kv_params.num_heads,
+        kv_params.head_size,
+    )
+    var blocks_lt = LayoutTensor[qkv_type, Layout.row_major[6]()](
+        blocks_device.unsafe_ptr(),
+        RuntimeLayout[Layout.row_major[6]()].row_major(block_shape),
+    )
+
+    comptime cl_layout = Layout(UNKNOWN_VALUE)
+    var cache_lengths_lt = LayoutTensor[DType.uint32, cl_layout](
+        cache_lengths_device.unsafe_ptr(),
+        RuntimeLayout[cl_layout].row_major(IndexList[1](batch_size)),
+    )
+
+    comptime lut_layout = Layout.row_major[2]()
+    var lookup_table_lt = LayoutTensor[DType.uint32, lut_layout](
+        lookup_table_device.unsafe_ptr(),
+        RuntimeLayout[lut_layout].row_major(IndexList[2](batch_size, num_pages)),
+    )
+
+    var kv_collection = PagedKVCacheCollection[qkv_type, kv_params, PAGE_SIZE](
+        LayoutTensor[qkv_type, Layout.row_major[6](), MutAnyOrigin](
+            blocks_lt.ptr.as_unsafe_any_origin(),
+            RuntimeLayout[Layout.row_major[6]()](
+                blocks_lt.runtime_layout.shape.value,
+                blocks_lt.runtime_layout.stride.value,
+            ),
+        ),
+        LayoutTensor[DType.uint32, cl_layout, ImmutAnyOrigin](
+            cache_lengths_lt.ptr.as_unsafe_any_origin(),
+            RuntimeLayout[cl_layout](
+                cache_lengths_lt.runtime_layout.shape.value,
+                cache_lengths_lt.runtime_layout.stride.value,
+            ),
+        ),
+        LayoutTensor[DType.uint32, lut_layout, ImmutAnyOrigin](
+            lookup_table_lt.ptr.as_unsafe_any_origin(),
+            RuntimeLayout[lut_layout](
+                lookup_table_lt.runtime_layout.shape.value,
+                lookup_table_lt.runtime_layout.stride.value,
+            ),
+        ),
+        UInt32(q_max_seq_len),
+        UInt32(cache_len),
+    )
+    var kv_cache = kv_collection.get_key_cache(0)
+
+    flare_mla_decoding[
+        rank=3,
+        config=MHAConfig[qkv_type](NUM_HEADS, DEPTH),
+        ragged=True,
+    ](
+        output_tt,
+        q_tt,
+        kv_cache,
+        NullMask(),
+        row_offsets_tt,
+        scale,
+        ctx,
+        scalar_args_tt,
+        q_max_seq_len=q_max_seq_len,
+    )
+    ctx.synchronize()
+
+    ctx.enqueue_copy(output_host, output_device)
+    ctx.synchronize()
+
+    var num_nonfinite = 0
+    for i in range(output_size):
+        var val = output_host.load(i).cast[DType.float32]()
+        if isnan(val) or isinf(val):
+            num_nonfinite += 1
+    if num_nonfinite != 0:
+        raise Error("Apple MLA decode smoke produced non-finite output")
+
+    print("Apple MLA decode smoke completed; non-finite outputs:", num_nonfinite)
+
+    q_host.free()
+    blocks_host.free()
+    output_host.free()
+    row_offsets_host.free()
+    cache_lengths_host.free()
+    lookup_table_host.free()
+
+
+def main() raises:
+    comptime if not has_apple_gpu_accelerator():
+        print("SKIP: Apple MLA decode targets Apple silicon GPUs only")
+        return
+    with DeviceContext() as ctx:
+        print("Apple MLA decode smoke compute_capability:", ctx.compute_capability())
+        seed(1)
+        _run(ctx)

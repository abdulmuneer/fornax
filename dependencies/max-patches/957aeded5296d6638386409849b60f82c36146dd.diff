index 0000000..4f73963
--- /dev/null
+++ b/max/kernels/test/gpu/nn/test_apple_moe_indices_smoke.mojo
@@ -0,0 +1,116 @@
+# ===----------------------------------------------------------------------=== #
+# Copyright (c) 2026, Modular Inc. All rights reserved.
+#
+# Licensed under the Apache License v2.0 with LLVM Exceptions:
+# https://llvm.org/LICENSE.txt
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ===----------------------------------------------------------------------=== #
+
+from layout import Idx, TileTensor, row_major
+from nn.moe import moe_create_indices
+from std.gpu.host import DeviceContext
+from std.sys import has_apple_gpu_accelerator
+from std.testing import assert_equal
+
+
+def test_apple_moe_create_indices_smoke(ctx: DeviceContext) raises:
+    comptime NUM_ASSIGNMENTS = 24
+    comptime NUM_EXPERTS = 8
+
+    var topk_h = ctx.enqueue_create_host_buffer[DType.uint32](NUM_ASSIGNMENTS)
+    var token_order_h = ctx.enqueue_create_host_buffer[DType.uint32](
+        NUM_ASSIGNMENTS
+    )
+    var restore_order_h = ctx.enqueue_create_host_buffer[DType.uint32](
+        NUM_ASSIGNMENTS
+    )
+    var expert_start_h = ctx.enqueue_create_host_buffer[DType.uint32](
+        NUM_EXPERTS + 1
+    )
+    var expert_ids_h = ctx.enqueue_create_host_buffer[DType.int32](NUM_EXPERTS)
+    var usage_h = ctx.enqueue_create_host_buffer[DType.uint32](2)
+
+    for i in range(NUM_ASSIGNMENTS):
+        topk_h[i] = UInt32(i % NUM_EXPERTS)
+
+    var topk_d = ctx.enqueue_create_buffer[DType.uint32](NUM_ASSIGNMENTS)
+    var token_order_d = ctx.enqueue_create_buffer[DType.uint32](
+        NUM_ASSIGNMENTS
+    )
+    var restore_order_d = ctx.enqueue_create_buffer[DType.uint32](
+        NUM_ASSIGNMENTS
+    )
+    var expert_start_d = ctx.enqueue_create_buffer[DType.uint32](
+        NUM_EXPERTS + 1
+    )
+    var expert_ids_d = ctx.enqueue_create_buffer[DType.int32](NUM_EXPERTS)
+    var usage_d = ctx.enqueue_create_buffer[DType.uint32](2)
+
+    ctx.enqueue_copy(topk_d, topk_h)
+
+    var topk = TileTensor(topk_d, row_major(NUM_ASSIGNMENTS))
+    var token_order = TileTensor(token_order_d, row_major(NUM_ASSIGNMENTS))
+    var restore_order = TileTensor(restore_order_d, row_major(NUM_ASSIGNMENTS))
+    var expert_start = TileTensor(expert_start_d, row_major(NUM_EXPERTS + 1))
+    var expert_ids = TileTensor(expert_ids_d, row_major(NUM_EXPERTS))
+    var usage = TileTensor(usage_d, row_major(Idx[2]))
+
+    moe_create_indices["gpu", expected_count=32](
+        token_order,
+        expert_start,
+        restore_order,
+        expert_ids,
+        usage,
+        topk,
+        ctx,
+    )
+
+    ctx.enqueue_copy(token_order_h, token_order_d)
+    ctx.enqueue_copy(restore_order_h, restore_order_d)
+    ctx.enqueue_copy(expert_start_h, expert_start_d)
+    ctx.enqueue_copy(expert_ids_h, expert_ids_d)
+    ctx.enqueue_copy(usage_h, usage_d)
+    ctx.synchronize()
+
+    assert_equal(usage_h[0], UInt32(3), "max tokens per expert mismatch")
+    assert_equal(usage_h[1], UInt32(NUM_EXPERTS), "expert count mismatch")
+    assert_equal(
+        expert_start_h[NUM_EXPERTS],
+        UInt32(NUM_ASSIGNMENTS),
+        "total token assignment count mismatch",
+    )
+
+    for expert_slot in range(Int(usage_h[1])):
+        var start = Int(expert_start_h[expert_slot])
+        var end = Int(expert_start_h[expert_slot + 1])
+        var expert_id = expert_ids_h[expert_slot]
+        for pos in range(start, end):
+            var token_idx = Int(token_order_h[pos])
+            assert_equal(
+                expert_id,
+                Int32(topk_h[token_idx]),
+                "expert range contains a token for a different expert",
+            )
+
+    for token_idx in range(NUM_ASSIGNMENTS):
+        var restored_pos = Int(restore_order_h[token_idx])
+        assert_equal(
+            token_idx,
+            Int(token_order_h[restored_pos]),
+            "restore order does not invert token expert order",
+        )
+
+
+def main() raises:
+    comptime if not has_apple_gpu_accelerator():
+        print("SKIP: Apple MoE indices smoke requires Apple GPU")
+        return
+
+    with DeviceContext() as ctx:
+        test_apple_moe_create_indices_smoke(ctx)
+        print("Apple MoE indices smoke passed")

+                    ragged=ragged,
+                    QDepth=q_depth,
+                    Depth=D,
+                    CacheDepth=cache_depth,
+                    NumNMmas=DEFAULT_NUM_N_MMAS_M3,
+                ]
+                ctx.enqueue_function[core_kernel](
+                    output_flat,
+                    q_flat,
+                    k,
+                    v,
+                    k_rope,
+                    mask_functor,
+                    valid_length_flat,
+                    cache_offsets,
+                    scale,
+                    batch_size,

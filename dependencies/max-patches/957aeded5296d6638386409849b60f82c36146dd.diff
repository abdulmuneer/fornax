+"""Apple (Metal) M5 MMA-based MLA prefill kernel.
+
+This is the Apple counterpart to `flare_mla_prefill`'s generic prefill path. It
+uses the same wide-threadgroup/no-SMEM style as `fa_prefill_apple`, but builds
+MLA scores from two terms:
+
+    score = Q_nope @ K_nope.T + Q_rope @ K_rope.T
+
+The first milestone is deliberately narrow: BF16/FP16 storage, FP32
+accumulation, head dimensions that are multiples of 16, no FP8 scale path, and
+MHAOperand-based paged/ragged K/V/K_rope operands.
+"""
+
+from std.collections import InlineArray, OptionalReg
+from std.gpu import WARP_SIZE, block_idx, lane_id, warp_id
+from std.gpu.compute.arch.mma_apple import (
+    _apple_frag_layout,
+    _mma_apple_8x8,
+    _mma_apple_transposable,
+)
+from std.gpu.host import DeviceContext, Dim as LaunchDim
+from std.gpu.memory import AddressSpace
+from std.gpu.primitives.warp import shuffle_xor
+from std.math import ceildiv, exp
+from std.sys.info import size_of
+from std.utils.index import Index
+from std.utils.numerics import get_accum_type
+
+from layout import UNKNOWN_VALUE, Idx, Layout, LayoutTensor, TileTensor
+from layout.coord import Coord
+from layout.tile_layout import Layout as TileLayout, TensorLayout, row_major
+
+from linalg.arch.apple.mma import MmaOpApple
+
+from nn.attention.mha_mask import CausalMask, MHAMask, TileMaskStatus
+from nn.attention.mha_operand import MHAOperand
+
+from .fa_prefill import (
+    AppleSoftmax,
+    DEFAULT_NUM_M_MMAS,
+    DEFAULT_NUM_N_MMAS,
+    FA_PREFILL_APPLE_MAX_HEAD_DIM,
+    MMA_DIM,
+    NEG_INF,
+)
+
+
+comptime MMA8_DIM = 8
+comptime DEFAULT_NUM_N_MMAS_M3 = 2
+
+
+@always_inline
+def _frag8_layout(lane: Int) -> Tuple[Int, Int]:
+    """Apple 8x8 simdgroup-matrix per-lane layout.
+
+    The lane owns `(row, col_base)` and `(row, col_base + 1)` in an 8x8
+    fragment. This is the same layout used by the M1-M4 matmul path.
+    """
+    return (
+        ((lane & 6) >> 1) + ((lane & 16) >> 2),
+        ((lane & 1) << 1) + ((lane & 8) >> 1),
+    )
+
+
+struct AppleSoftmax8[num_n_mmas: Int]:
+    """Online-softmax state for an Apple 8x8 score tile.
+
+    One simdgroup owns 8 query rows. Each lane owns one row and two columns of
+    every 8x8 score fragment, so the per-row running max/sum are scalar in each
+    lane. The lanes sharing a row differ by XOR masks `{1, 8}`.
+    """
+
+    var m: Float32
+    var l: Float32
+
+    @always_inline
+    def __init__(out self):
+        self.m = NEG_INF
+        self.l = 0
+
+    @staticmethod
+    @always_inline
+    def _row_max(
+        scores: InlineArray[SIMD[DType.float32, 2], Self.num_n_mmas],
+    ) -> Float32:
+        var r = NEG_INF
+        comptime for ni in range(Self.num_n_mmas):
+            var frag = scores[ni]
+            r = max(r, max(frag[0], frag[1]))
+        r = max(r, shuffle_xor(r, UInt32(1)))
+        r = max(r, shuffle_xor(r, UInt32(8)))
+        return r
+
+    @staticmethod
+    @always_inline
+    def _row_sum(
+        scores: InlineArray[SIMD[DType.float32, 2], Self.num_n_mmas],
+    ) -> Float32:
+        var r = Float32(0)
+        comptime for ni in range(Self.num_n_mmas):
+            var frag = scores[ni]
+            r += frag[0] + frag[1]
+        r += shuffle_xor(r, UInt32(1))
+        r += shuffle_xor(r, UInt32(8))
+        return r
+
+    @always_inline
+    def update[
+        out_num_n_mmas: Int
+    ](
+        mut self,
+        mut scores: InlineArray[SIMD[DType.float32, 2], Self.num_n_mmas],
+        mut output: InlineArray[SIMD[DType.float32, 2], out_num_n_mmas],
+    ):
+        var m_tile = Self._row_max(scores)
+        var m_new = max(self.m, m_tile)
+        var alpha = exp(self.m - m_new)
+
+        comptime for ni in range(Self.num_n_mmas):
+            scores[ni] = exp(
+                scores[ni] - SIMD[DType.float32, 2](m_new)
+            )
+
+        self.l = self.l * alpha + Self._row_sum(scores)
+        self.m = m_new
+
+        comptime for ni in range(out_num_n_mmas):
+            output[ni] = output[ni] * SIMD[DType.float32, 2](alpha)
+
+    @always_inline
+    def normalize[
+        out_num_n_mmas: Int
+    ](
+        self,
+        mut output: InlineArray[SIMD[DType.float32, 2], out_num_n_mmas],
+    ):
+        var inv = Float32(0)
+        if self.l > 0:
+            inv = Float32(1) / self.l
+        comptime for ni in range(out_num_n_mmas):
+            output[ni] = output[ni] * SIMD[DType.float32, 2](inv)
+
+
+def mla_prefill_apple_core[
+    q_type: DType,
+    output_type: DType,
+    p_type: DType,
+    k_t: MHAOperand,
+    v_t: MHAOperand,
+    k_rope_t: MHAOperand,
+    mask_t: MHAMask,
+    q_layout: TensorLayout,
+    output_layout: TensorLayout,
+    valid_length_layout: TensorLayout,
+    ragged: Bool = True,
+    *,
+    QDepth: Int,
+    Depth: Int,
+    CacheDepth: Int,
+    NumMMmas: Int,
+    NumNMmas: Int,
+    NumSimdgroups: Int = 16,
+](
+    output: TileTensor[output_type, output_layout, MutAnyOrigin],
+    q: TileTensor[q_type, q_layout, ImmutAnyOrigin],
+    k: k_t,
+    v: v_t,
+    k_rope: k_rope_t,
+    mask_functor: mask_t,
+    valid_length: TileTensor[
+        DType.uint32,
+        valid_length_layout,
+        ImmutAnyOrigin,
+    ],
+    cache_offsets: OptionalReg[
+        LayoutTensor[
+            DType.uint32, Layout.row_major(UNKNOWN_VALUE), MutAnyOrigin
+        ]
+    ],
+    scale: Float32,
+    batch_size: Int,
+    max_prompt_len: Int,
+    num_heads: Int,
+    depth: Int,
+    q_depth: Int,
+    group: Int,
+):
+    comptime assert Depth % MMA_DIM == 0, "Depth must be a multiple of 16"
+    comptime assert QDepth % MMA_DIM == 0, "QDepth must be a multiple of 16"
+    comptime assert QDepth > Depth, "MLA prefill requires rope dimensions"
+    comptime assert k_t.page_size == 0 or k_t.page_size % MMA_DIM == 0, (
+        "mla_prefill_apple_core requires contiguous K/V or page_size % 16 == 0"
+    )
+    comptime assert k_rope_t.page_size == 0 or k_rope_t.page_size % MMA_DIM == 0, (
+        "mla_prefill_apple_core requires contiguous K_rope or page_size % 16 == 0"
+    )
+
+    comptime RopeDepth = QDepth - Depth
+    comptime SQ = NumMMmas * MMA_DIM
+    comptime SK = NumNMmas * MMA_DIM
+    comptime DEPTH_MMAS = Depth // MMA_DIM
+    debug_assert(depth == Depth, "runtime depth must match comptime Depth")
+    debug_assert(q_depth == QDepth, "runtime q_depth must match comptime QDepth")
+
+    var q_tile_id = Int(block_idx.x)
+    var head_id = Int(block_idx.y)
+    var batch_id = Int(block_idx.z)
+    var kv_head = head_id // group
+    var sg = Int(warp_id())
+    var lane = Int(lane_id())
+    var rb_cb = _apple_frag_layout(lane)
+    var rb = rb_cb[0]
+    var cb = rb_cb[1]
+
+    var seq_start: Int
+    var cur_query_len: Int
+    comptime if ragged:
+        seq_start = Int(valid_length[batch_id])
+        var seq_end = Int(valid_length[batch_id + 1])
+        cur_query_len = seq_end - seq_start
+    else:
+        seq_start = batch_id * max_prompt_len
+        cur_query_len = max_prompt_len
+
+    var q_row0 = q_tile_id * (NumSimdgroups * SQ) + sg * SQ
+    if q_row0 >= cur_query_len:
+        return
+
+    var cache_start_pos: Int = 0
+    if cache_offsets:
+        cache_start_pos = Int(cache_offsets.value()[batch_id][0])
+
+    var start_pos = k_rope.cache_length(batch_id)
+    var cur_cache_len = start_pos + cur_query_len
+    var score_row_base = q_row0 + start_pos
+    var valid_q = min(SQ, cur_query_len - q_row0)
+
+    var q_row_stride = num_heads * q_depth
+    var out_row_stride = num_heads * depth
+    var q_offset = q_depth * (seq_start * num_heads + head_id)
+    var out_offset = depth * (seq_start * num_heads + head_id)
+
+    var q_nope_layout_val = TileLayout(
+        Coord(Idx[SQ], Idx[Depth]), Coord(q_row_stride, Idx[1])
+    )
+    var q_rope_layout_val = TileLayout(
+        Coord(Idx[SQ], Idx[RopeDepth]), Coord(q_row_stride, Idx[1])
+    )
+    var q_nope_tile = TileTensor[
+        q_type, type_of(q_nope_layout_val), ImmutAnyOrigin
+    ](
+        ptr=q.ptr + q_offset + q_row0 * q_row_stride,
+        layout=q_nope_layout_val,
+    )
+    var q_rope_tile = TileTensor[
+        q_type, type_of(q_rope_layout_val), ImmutAnyOrigin
+    ](
+        ptr=q.ptr + q_offset + q_row0 * q_row_stride + Depth,
+        layout=q_rope_layout_val,
+    )
+
+    var k_base0 = k.block_paged_ptr[1](
+        UInt32(batch_id), UInt32(0), UInt32(kv_head), 0
+    )
+    var k_base1 = k.block_paged_ptr[1](
+        UInt32(batch_id), UInt32(1), UInt32(kv_head), 0
+    )
+    comptime kv_elt_size = size_of[Scalar[k_t.dtype]]()
+    var kv_row_stride = (Int(k_base1) - Int(k_base0)) // kv_elt_size
+    var kv_layout_val = TileLayout(
+        Coord(Idx[MMA_DIM], Idx[Depth]), Coord(kv_row_stride, Idx[1])
+    )
+
+    comptime k_rope_offset = CacheDepth - RopeDepth
+    var kr_base0 = k_rope.block_paged_ptr[1](
+        UInt32(batch_id), UInt32(0), UInt32(kv_head), UInt32(k_rope_offset)
+    )
+    var kr_base1 = k_rope.block_paged_ptr[1](
+        UInt32(batch_id), UInt32(1), UInt32(kv_head), UInt32(k_rope_offset)
+    )
+    comptime kr_elt_size = size_of[Scalar[k_rope_t.dtype]]()
+    var kr_row_stride = (Int(kr_base1) - Int(kr_base0)) // kr_elt_size
+    var k_rope_layout_val = TileLayout(
+        Coord(Idx[MMA_DIM], Idx[RopeDepth]), Coord(kr_row_stride, Idx[1])
+    )
+
+    comptime ScoreNopeMma = MmaOpApple[
+        DType.float32,
+        q_type,
+        NumMMmas,
+        1,
+        b_type=k_t.dtype,
+        transpose_b=True,
+    ]
+    comptime ScoreRopeMma = MmaOpApple[
+        DType.float32,
+        q_type,
+        NumMMmas,
+        1,
+        b_type=k_rope_t.dtype,
+        transpose_b=True,
+    ]
+    comptime ScoreAccum = MmaOpApple[
+        DType.float32, q_type, NumMMmas, NumNMmas, transpose_b=True
+    ]
+    comptime OutMma = MmaOpApple[DType.float32, q_type, NumMMmas, DEPTH_MMAS]
+
+    var score_nope_mma = ScoreNopeMma()
+    var score_rope_mma = ScoreRopeMma()
+    var out_mma = OutMma()
+    var output_accum = OutMma.zero_accum()
+    var softmax = AppleSoftmax[NumMMmas, NumNMmas]()
+    comptime causal_monotonic = mask_t == CausalMask
+
+    var kv0 = 0
+    while kv0 < cur_cache_len:
+        var tile_status = mask_functor.status[element_type=DType.uint32](
+            UInt32(batch_id),
+            Index[dtype=DType.uint32](score_row_base, kv0 + cache_start_pos),
+            Index[dtype=DType.uint32](SQ, SK),
+        )
+        if tile_status == TileMaskStatus.FULL_MASK:
+            comptime if causal_monotonic:
+                break
+            else:
+                kv0 += SK
+                continue
+
+        var scores = ScoreAccum.zero_accum()
+        comptime for ni in range(NumNMmas):
+            var k_sub = k.block_paged_tile[1](
+                UInt32(batch_id),
+                UInt32(kv0 + ni * MMA_DIM),
+                UInt32(kv_head),
+                kv_layout_val,
+            )
+            var score_nope = ScoreNopeMma.zero_accum()
+            score_nope_mma.mma(score_nope, q_nope_tile, k_sub)
+
+            var kr_sub = k_rope.block_paged_tile[1](
+                UInt32(batch_id),
+                UInt32(kv0 + ni * MMA_DIM + cache_start_pos),
+                UInt32(kv_head),
+                k_rope_layout_val,
+                UInt32(k_rope_offset),
+            )
+            var score_rope = ScoreRopeMma.zero_accum()
+            score_rope_mma.mma(score_rope, q_rope_tile, kr_sub)
+
+            comptime for mi in range(NumMMmas):
+                scores[mi * NumNMmas + ni] = rebind[
+                    type_of(scores[mi * NumNMmas + ni])
+                ](score_nope[mi] + score_rope[mi])
+
+        comptime for mi in range(NumMMmas):
+            comptime for ni in range(NumNMmas):
+                var idx = mi * NumNMmas + ni
+                var frag = scores[idx]
+                comptime for el in range(8):
+                    var lrow = mi * MMA_DIM + rb + (8 if el > 3 else 0)
+                    var lcol = ni * MMA_DIM + cb + (el & 3)
+                    var key = kv0 + lcol
+                    var qrow = q_row0 + lrow
+                    var s = frag[el] * scale
+                    if qrow < cur_query_len and key < cur_cache_len:
+                        frag[el] = mask_functor.mask(
+                            Index(
+                                batch_id,
+                                head_id,
+                                score_row_base + lrow,
+                                key + cache_start_pos,
+                            ),
+                            s,
+                        )
+                    else:
+                        frag[el] = NEG_INF
+                scores[idx] = frag
+
+        softmax.update[DEPTH_MMAS](scores, output_accum)
+
+        var sk_tile_full = kv0 + SK <= cur_cache_len
+        if sk_tile_full:
+            comptime for ki in range(NumNMmas):
+                var p_frags = InlineArray[SIMD[q_type, 8], NumMMmas](
+                    uninitialized=True
+                )
+                comptime for mi in range(NumMMmas):
+                    p_frags[mi] = scores[mi * NumNMmas + ki].cast[q_type]()
+                var v_tile = v.block_paged_tile[1](
+                    UInt32(batch_id),
+                    UInt32(kv0 + ki * MMA_DIM),
+                    UInt32(kv_head),
+                    kv_layout_val,
+                )
+                comptime for ni in range(DEPTH_MMAS):
+                    var v_sub = v_tile.tile[MMA_DIM, MMA_DIM](0, ni)
+                    var v_frag = out_mma.load_fragment[v_t.dtype](v_sub).cast[
+                        q_type
+                    ]()
+                    comptime for mi in range(NumMMmas):
+                        var oidx = mi * DEPTH_MMAS + ni
+                        _mma_apple_transposable(
+                            output_accum[oidx],
+                            p_frags[mi],
+                            v_frag,
+                            output_accum[oidx],
+                            False,
+                            False,
+                        )
+        else:
+            comptime for ki in range(NumNMmas):
+                var p_frags = InlineArray[SIMD[q_type, 8], NumMMmas](
+                    uninitialized=True
+                )
+                comptime for mi in range(NumMMmas):
+                    p_frags[mi] = scores[mi * NumNMmas + ki].cast[q_type]()
+                var v_tile = v.block_paged_tile[1](
+                    UInt32(batch_id),
+                    UInt32(kv0 + ki * MMA_DIM),
+                    UInt32(kv_head),
+                    kv_layout_val,
+                )
+                var v_valid_rows = cur_cache_len - (kv0 + ki * MMA_DIM)
+                comptime for ni in range(DEPTH_MMAS):
+                    var v_sub = v_tile.tile[MMA_DIM, MMA_DIM](0, ni)
+                    var v_frag: SIMD[v_t.dtype, 8]
+                    if v_valid_rows >= MMA_DIM:
+                        v_frag = out_mma.load_fragment[v_t.dtype](v_sub)
+                    else:
+                        v_frag = out_mma.load_fragment[v_t.dtype, bounded=True](
+                            v_sub, v_valid_rows
+                        )
+                    var v_frag_q = v_frag.cast[q_type]()
+                    comptime for mi in range(NumMMmas):
+                        var oidx = mi * DEPTH_MMAS + ni
+                        _mma_apple_transposable(
+                            output_accum[oidx],
+                            p_frags[mi],
+                            v_frag_q,
+                            output_accum[oidx],
+                            False,
+                            False,
+                        )
+
+        kv0 += SK
+
+    softmax.normalize[DEPTH_MMAS](output_accum)
+
+    var out_layout_val = TileLayout(
+        Coord(Idx[SQ], Idx[Depth]), Coord(out_row_stride, Idx[1])
+    )
+    var out_tile = TileTensor[
+        output_type, type_of(out_layout_val), MutAnyOrigin
+    ](
+        ptr=output.ptr + out_offset + q_row0 * out_row_stride,
+        layout=out_layout_val,
+    )
+    comptime for mi in range(NumMMmas):
+        comptime for ni in range(DEPTH_MMAS):
+            var o_sub = out_tile.tile[MMA_DIM, MMA_DIM](mi, ni)
+            var frag = output_accum[mi * DEPTH_MMAS + ni]
+            comptime for el in range(8):
+                var lrow = rb + (8 if el > 3 else 0)
+                var lcol = cb + (el & 3)
+                if (
+                    mi * MMA_DIM + lrow < valid_q
+                    and ni * MMA_DIM + lcol < depth
+                ):
+                    o_sub[lrow, lcol] = rebind[o_sub.ElementType](
+                        SIMD[output_type, 1](frag[el].cast[output_type]())
+                    )
+
+
+def mla_prefill_apple_m3_core[
+    q_type: DType,
+    output_type: DType,
+    k_t: MHAOperand,
+    v_t: MHAOperand,
+    k_rope_t: MHAOperand,
+    mask_t: MHAMask,
+    q_layout: TensorLayout,
+    output_layout: TensorLayout,
+    valid_length_layout: TensorLayout,
+    ragged: Bool = True,
+    *,
+    QDepth: Int,
+    Depth: Int,
+    CacheDepth: Int,
+    NumNMmas: Int,
+](
+    output: TileTensor[output_type, output_layout, MutAnyOrigin],
+    q: TileTensor[q_type, q_layout, ImmutAnyOrigin],
+    k: k_t,
+    v: v_t,
+    k_rope: k_rope_t,
+    mask_functor: mask_t,
+    valid_length: TileTensor[
+        DType.uint32,
+        valid_length_layout,
+        ImmutAnyOrigin,
+    ],
+    cache_offsets: OptionalReg[
+        LayoutTensor[
+            DType.uint32, Layout.row_major(UNKNOWN_VALUE), MutAnyOrigin
+        ]
+    ],
+    scale: Float32,
+    batch_size: Int,
+    max_prompt_len: Int,
+    num_heads: Int,
+    depth: Int,
+    q_depth: Int,
+    group: Int,
+):
+    comptime assert Depth % MMA8_DIM == 0, "Depth must be a multiple of 8"
+    comptime assert QDepth % MMA8_DIM == 0, "QDepth must be a multiple of 8"
+    comptime assert QDepth > Depth, "MLA prefill requires rope dimensions"
+
+    comptime RopeDepth = QDepth - Depth
+    comptime SQ = MMA8_DIM
+    comptime SK = NumNMmas * MMA8_DIM
+    comptime DEPTH_MMAS = Depth // MMA8_DIM
+    debug_assert(depth == Depth, "runtime depth must match comptime Depth")
+    debug_assert(q_depth == QDepth, "runtime q_depth must match comptime QDepth")
+
+    var q_tile_id = Int(block_idx.x)
+    var head_id = Int(block_idx.y)
+    var batch_id = Int(block_idx.z)
+    var kv_head = head_id // group
+    var lane = Int(lane_id())
+    var fl = _frag8_layout(lane)
+    var frow = fl[0]
+    var fcol = fl[1]
+
+    var seq_start: Int
+    var cur_query_len: Int
+    comptime if ragged:
+        seq_start = Int(valid_length[batch_id])
+        var seq_end = Int(valid_length[batch_id + 1])
+        cur_query_len = seq_end - seq_start
+    else:
+        seq_start = batch_id * max_prompt_len
+        cur_query_len = max_prompt_len
+
+    var q_row0 = q_tile_id * SQ
+    if q_row0 >= cur_query_len:
+        return
+
+    var cache_start_pos: Int = 0
+    if cache_offsets:
+        cache_start_pos = Int(cache_offsets.value()[batch_id][0])
+
+    var start_pos = k_rope.cache_length(batch_id)
+    var cur_cache_len = start_pos + cur_query_len
+    var score_row_base = q_row0 + start_pos
+    var valid_q = min(SQ, cur_query_len - q_row0)
+
+    var q_row_stride = num_heads * q_depth
+    var out_row_stride = num_heads * depth
+    var q_offset = q_depth * (seq_start * num_heads + head_id)
+    var out_offset = depth * (seq_start * num_heads + head_id)
+    comptime k_rope_offset = CacheDepth - RopeDepth
+
+    var output_accum = InlineArray[SIMD[DType.float32, 2], DEPTH_MMAS](
+        fill=SIMD[DType.float32, 2](0)
+    )
+    var softmax = AppleSoftmax8[NumNMmas]()
+    comptime causal_monotonic = mask_t == CausalMask
+
+    var kv0 = 0
+    while kv0 < cur_cache_len:
+        var tile_status = mask_functor.status[element_type=DType.uint32](
+            UInt32(batch_id),
+            Index[dtype=DType.uint32](score_row_base, kv0 + cache_start_pos),
+            Index[dtype=DType.uint32](SQ, SK),
+        )
+        if tile_status == TileMaskStatus.FULL_MASK:
+            comptime if causal_monotonic:
+                break
+            else:
+                kv0 += SK
+                continue
+
+        var scores = InlineArray[SIMD[DType.float32, 2], NumNMmas](
+            fill=SIMD[DType.float32, 2](0)
+        )
+
+        comptime for ni in range(NumNMmas):
+            var score_nope = SIMD[DType.float32, 2](0)
+            comptime for kk in range(Depth // MMA8_DIM):
+                var q_frag = SIMD[q_type, 2](0)
+                if q_row0 + frow < cur_query_len:
+                    q_frag = (
+                        q.ptr
+                        + q_offset
+                        + (q_row0 + frow) * q_row_stride
+                        + kk * MMA8_DIM
+                        + fcol
+                    ).load[width=2]()
+                var k_frag = SIMD[k_t.dtype, 2](0)
+                comptime for s in range(2):
+                    var key = kv0 + ni * MMA8_DIM + fcol + s
+                    if key < cur_cache_len:
+                        var k_ptr = k.block_paged_ptr[1](
+                            UInt32(batch_id),
+                            UInt32(key),
+                            UInt32(kv_head),
+                            UInt32(kk * MMA8_DIM + frow),
+                        )
+                        k_frag[s] = k_ptr[0]
+                var c_frag = score_nope
+                _mma_apple_8x8(score_nope, q_frag, k_frag, c_frag)
+
+            var score_rope = SIMD[DType.float32, 2](0)
+            comptime for kk in range(RopeDepth // MMA8_DIM):
+                var q_frag = SIMD[q_type, 2](0)
+                if q_row0 + frow < cur_query_len:
+                    q_frag = (
+                        q.ptr
+                        + q_offset
+                        + (q_row0 + frow) * q_row_stride
+                        + Depth
+                        + kk * MMA8_DIM
+                        + fcol
+                    ).load[width=2]()
+                var kr_frag = SIMD[k_rope_t.dtype, 2](0)
+                comptime for s in range(2):
+                    var key = kv0 + ni * MMA8_DIM + fcol + s
+                    if key < cur_cache_len:
+                        var kr_ptr = k_rope.block_paged_ptr[1](
+                            UInt32(batch_id),
+                            UInt32(key + cache_start_pos),
+                            UInt32(kv_head),
+                            UInt32(k_rope_offset + kk * MMA8_DIM + frow),
+                        )
+                        kr_frag[s] = kr_ptr[0]
+                var c_frag = score_rope
+                _mma_apple_8x8(score_rope, q_frag, kr_frag, c_frag)
+
+            scores[ni] = score_nope + score_rope
+
+        comptime for ni in range(NumNMmas):
+            var frag = scores[ni]
+            comptime for s in range(2):
+                var lrow = frow
+                var lcol = ni * MMA8_DIM + fcol + s
+                var key = kv0 + lcol
+                var qrow = q_row0 + lrow
+                var score = frag[s] * scale
+                if qrow < cur_query_len and key < cur_cache_len:
+                    frag[s] = mask_functor.mask(
+                        Index(
+                            batch_id,
+                            head_id,
+                            score_row_base + lrow,
+                            key + cache_start_pos,
+                        ),
+                        score,
+                    )
+                else:
+                    frag[s] = NEG_INF
+            scores[ni] = frag
+
+        softmax.update[DEPTH_MMAS](scores, output_accum)
+
+        comptime for ki in range(NumNMmas):
+            var p_frag = scores[ki].cast[q_type]()
+            comptime for di in range(DEPTH_MMAS):
+                var v_frag = SIMD[v_t.dtype, 2](0)
+                comptime for s in range(2):
+                    var key = kv0 + ki * MMA8_DIM + frow
+                    var dcol = di * MMA8_DIM + fcol + s
+                    if key < cur_cache_len and dcol < Depth:
+                        var v_ptr = v.block_paged_ptr[1](
+                            UInt32(batch_id),
+                            UInt32(key),
+                            UInt32(kv_head),
+                            UInt32(dcol),
+                        )
+                        v_frag[s] = v_ptr[0]
+                var c_frag = output_accum[di]
+                _mma_apple_8x8(
+                    output_accum[di], p_frag, v_frag, c_frag
+                )
+
+        kv0 += SK
+
+    softmax.normalize[DEPTH_MMAS](output_accum)
+
+    if frow < valid_q:
+        comptime for di in range(DEPTH_MMAS):
+            var frag = output_accum[di]
+            comptime for s in range(2):
+                var dcol = di * MMA8_DIM + fcol + s
+                if dcol < depth:
+                    output.ptr[
+                        out_offset + (q_row0 + frow) * out_row_stride + dcol
+                    ] = frag[s].cast[output_type]()
+
+
+def mla_prefill_apple[
+    q_type: DType,
+    output_type: DType,
+    k_t: MHAOperand,
+    v_t: MHAOperand,
+    k_rope_t: MHAOperand,
+    mask_t: MHAMask,
+    *,
+    q_depth: Int = 192,
+    cache_depth: Int = 576,
+    ragged: Bool = True,
+    num_simdgroups: Int = 16,
+](
+    output: TileTensor[
+        mut=True, output_type, address_space=AddressSpace.GENERIC, ...
+    ],
+    q: TileTensor[q_type, address_space=AddressSpace.GENERIC, ...],
+    k: k_t,
+    v: v_t,
+    k_rope: k_rope_t,
+    mask_functor: mask_t,
+    valid_length: TileTensor[
+        DType.uint32, address_space=AddressSpace.GENERIC, ...
+    ],
+    cache_offsets: OptionalReg[
+        LayoutTensor[
+            DType.uint32, Layout.row_major(UNKNOWN_VALUE), MutAnyOrigin
+        ]
+    ],
+    max_prompt_len: Int,
+    scale: Float32,
+    batch_size: Int,
+    num_heads: Int,
+    depth: Int,
+    group: Int,
+    ctx: DeviceContext,
+) raises:
+    comptime p_type = get_accum_type[q_type]()
+    comptime assert q_type in (DType.bfloat16, DType.float16), (
+        "mla_prefill_apple initially supports bf16/fp16 inputs only"
+    )
+    comptime assert output_type in (DType.bfloat16, DType.float16), (
+        "mla_prefill_apple initially supports bf16/fp16 outputs only"
+    )
+    comptime assert k_t.dtype == q_type and v_t.dtype == q_type, (
+        "mla_prefill_apple expects K/V dtype to match Q dtype"
+    )
+    comptime assert k_rope_t.dtype == q_type, (
+        "mla_prefill_apple initially expects K_rope dtype to match Q dtype"
+    )
+    comptime assert q_depth % MMA_DIM == 0, "q_depth must be a multiple of 16"
+
+    if batch_size == 0 or max_prompt_len == 0:
+        return
+
+    debug_assert(
+        depth % MMA_DIM == 0 and depth <= FA_PREFILL_APPLE_MAX_HEAD_DIM,
+        "mla_prefill_apple requires depth %% 16 == 0 and supported Apple depth",
+    )
+    debug_assert(q_depth > depth, "mla_prefill_apple requires q_depth > depth")
+
+    comptime NumMMmas = DEFAULT_NUM_M_MMAS
+    comptime NumNMmas = DEFAULT_NUM_N_MMAS
+    comptime SQ = NumMMmas * MMA_DIM
+    var num_q_tiles = ceildiv(max_prompt_len, num_simdgroups * SQ)
+
+    var q_flat = TileTensor(
+        q.ptr.as_immutable().as_unsafe_any_origin(),
+        row_major(Coord(Int(q.num_elements()))),
+    )
+    var output_flat = TileTensor(
+        output.ptr.as_unsafe_any_origin(),
+        row_major(Coord(Int(output.num_elements()))),
+    )
+    var valid_length_flat = TileTensor(
+        valid_length.ptr.as_immutable().as_unsafe_any_origin(),
+        row_major(Coord(Int(valid_length.num_elements()))),
+    )
+
+    comptime MAX_D_STEPS = FA_PREFILL_APPLE_MAX_HEAD_DIM // MMA_DIM
+    comptime for di in range(1, MAX_D_STEPS + 1):
+        comptime D = di * MMA_DIM
+        comptime if D < q_depth:
+            if depth == D:
+                comptime core_kernel = mla_prefill_apple_core[
+                    q_type,
+                    output_type,
+                    p_type,
+                    k_t,
+                    v_t,
+                    k_rope_t,
+                    mask_t,
+                    type_of(q_flat).LayoutType,
+                    type_of(output_flat).LayoutType,
+                    type_of(valid_length_flat).LayoutType,
+                    ragged=ragged,
+                    QDepth=q_depth,
+                    Depth=D,
+                    CacheDepth=cache_depth,
+                    NumMMmas=NumMMmas,
+                    NumNMmas=NumNMmas,
+                    NumSimdgroups=num_simdgroups,
+                ]
+                ctx.enqueue_function[core_kernel](
+                    output_flat,
+                    q_flat,
+                    k,
+                    v,
+                    k_rope,
+                    mask_functor,
+                    valid_length_flat,
+                    cache_offsets,
+                    scale,
+                    batch_size,
+                    max_prompt_len,
+                    num_heads,
+                    depth,
+                    q_depth,
+                    group,
+                    grid_dim=LaunchDim(num_q_tiles, num_heads, batch_size),
+                    block_dim=(num_simdgroups * WARP_SIZE, 1, 1),
+                )
+                return
+
+    debug_assert(False, "unsupported runtime depth for mla_prefill_apple")
+
+
